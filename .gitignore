# Stashed result JSONs from uWS test runs
uws-*.json

# AnyCable Pro binaries are licensed and MUST NEVER be committed to this
# public repo. These patterns match the asset names from the private
# anycable/anycable-go-pro-releases repo. The Pro deployment lives in
# its own directory outside this repo; if a binary ever ends up here by
# accident, git will refuse to track it.
anycable-go-linux-*
anycable-go-darwin-*
anycable-go-windows-*
anycable-go-mrb-*
anycable-thruster-*
.gstack/

# Scratch result JSONs from local bench-runner driver invocations.
backend/jitter-multi-*.json
backend/whispers-*.json
backend/deploy-impact-*.json

# Ad-hoc sweep scripts; the manifest in src/bench/tests-manifest.ts is canonical.
.standalone-throughput-sweep.sh
.latency-sweep.sh
.csr-test-queue.sh
