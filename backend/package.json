    "bench:jitter:uws": "tsx src/bench/jitter-uws.ts",
    "bench:avalanche:socketio": "tsx src/bench/avalanche-socketio.ts",
    "bench:avalanche:railway": "tsx src/bench/avalanche-railway-socketio.ts",
